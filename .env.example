# Server Port
PORT=5000

# Optional Music Metadata Provider Keys (Leave empty for free open endpoints)
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# LRCLIB User Agent (Custom identifier for lyrics queries)
LRCLIB_USER_AGENT=TamilMusicFinder/1.0 (https://github.com/tamil-music-finder)
